{Ti11,   11,    2}
{Ti12,   12,    2}
{Ti13,   13,    2}
{Ti14,   14,    2}
{Ti15,   15,    2}
{Ti16,   16,    2}
{Ti17,   17,    2}
{Ti18,   18,    2}
{Ti19,   19,    2}
